PORT=5000
CLIENT_URL=http://localhost:5173

# Leave empty to keep contacts in memory for the life of the process.
MONGODB_URI=
MONGODB_DB=trie_connect

# Load server/data/sample-contacts.json when the store is empty.
# Defaults to true without MongoDB, false with it.
SEED_SAMPLE=

# Only needed if the engine isn't at cpp/build/trie_engine
TRIE_ENGINE_PATH=
